# Pratala API — copy to backend/.env. Never commit real values.

NODE_ENV=development
PORT=4100

# Postgres from the root docker-compose.yml (host port 5433). Inside compose the
# api service overrides this with host "postgres" port 5432.
DATABASE_URL=postgresql://pratala:pratala@localhost:5433/pratala

# Session cookie (pratala_session) signing key, >= 16 chars. Generate: openssl rand -hex 32
JWT_SECRET=change-me-dev-only-0000000000000000
JWT_TTL_SECONDS=604800

# NEP-413 sign-in: the wallet signs {message, recipient, nonce}
AUTH_RECIPIENT=lots.pratala.testnet
AUTH_MESSAGE=Sign in to Pratala

# Chain (see deploy/testnet.json after scripts/03-deploy-contracts.sh)
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
LOTS_CONTRACT_ID=lots.pratala.testnet
PUSDC_CONTRACT_ID=pusdc.pratala.testnet
EXPLORER_BASE=https://testnet.nearblocks.io

# Web app origin allowed by CORS (credentials: true)
FRONTEND_ORIGIN=http://localhost:3000
# Public base URL used to build evidence URIs (…/api/evidence/<sha256>)
PUBLIC_API_URL=http://localhost:4100

# Evidence storage: Google Cloud Storage only — required, no local fallback.
# The API refuses to boot when GCS_BUCKET is missing or the bucket is unreachable.
GCS_BUCKET=pratala-evidence
# Optional path to a service-account JSON. Omit to use Application Default
# Credentials (GOOGLE_APPLICATION_CREDENTIALS / gcloud auth application-default login).
GCS_KEY_FILE=

# NEAR Intents 1Click (mainnet only). Optional partner key; without it 1Click adds 0.25%.
NEAR_INTENTS_BASE_URL=https://1click.chaindefuser.com/v0
NEAR_INTENTS_API_KEY=

# NEAR AI Cloud (OpenAI-compatible). Empty key => POST /api/ai/check returns 503 ai_unavailable.
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
NEAR_AI_FALLBACK_MODEL=z-ai/glm-5.3-flash

# Reconcile get_lots into the Lot mirror every N ms (0 disables)
INDEXER_POLL_MS=30000

# Seller account for the demo farm-input listings (prisma/seed.ts)
SEED_SUPPLIER_ID=supplier.pratala.testnet
