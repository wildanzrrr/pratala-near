# Pratala API — copy to backend/.env. Never commit real values.

NODE_ENV=development
PORT=4100

# External Postgres (no longer bundled in docker-compose). Host-run dev:
# localhost. Running the API in Docker: use host "host.docker.internal" so the
# container reaches a Postgres on the docker host (resolves on Docker Desktop
# and, via extra_hosts in the compose file, on Linux servers).
DATABASE_URL=postgresql://pratala:pratala@localhost:5432/pratala

# Session cookie (pratala_session) signing key, >= 16 chars. Generate: openssl rand -hex 32
JWT_SECRET=change-me-dev-only-0000000000000000
JWT_TTL_SECONDS=604800

# NEP-413 sign-in: the wallet signs {message, recipient, nonce}
AUTH_RECIPIENT=lots.pratala.testnet
AUTH_MESSAGE=Sign in to Pratala

# Chain (see deploy/testnet.json after scripts/03-deploy-contracts.sh)
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
LOTS_CONTRACT_ID=lots.pratala.testnet
PUSDC_CONTRACT_ID=pusdc.pratala.testnet
EXPLORER_BASE=https://testnet.nearblocks.io

# Web app origin allowed by CORS (credentials: true)
FRONTEND_ORIGIN=http://localhost:3000
# Public base URL used to build evidence URIs (…/api/evidence/<sha256>)
PUBLIC_API_URL=http://localhost:4100

# Evidence storage: Google Cloud Storage only — required, no local fallback.
# The API refuses to boot when GCS_BUCKET is missing or the bucket is unreachable.
GCS_BUCKET=pratala-evidence
# Optional path to a service-account JSON; relative paths resolve from the
# backend/ folder (e.g. ../config/gcs-key.json). Omit to use Application
# Default Credentials (GOOGLE_APPLICATION_CREDENTIALS / gcloud auth application-default login).
GCS_KEY_FILE=

# NEAR Intents 1Click (mainnet only). Optional partner key; without it 1Click adds 0.25%.
NEAR_INTENTS_BASE_URL=https://1click.chaindefuser.com/v0
NEAR_INTENTS_API_KEY=

# NEAR AI Cloud (OpenAI-compatible). Empty key => POST /api/ai/check returns 503 ai_unavailable.
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
NEAR_AI_FALLBACK_MODEL=z-ai/glm-5.3-flash

# Reconcile get_lots into the Lot mirror every N ms (0 disables)
INDEXER_POLL_MS=30000

# Seller account for the demo farm-input listings (prisma/seed.ts)
SEED_SUPPLIER_ID=supplier.pratala.testnet

# --- NEAR Auth (email/Google SSO → MPC accounts) -----------------------------
# Contracts + Auth0 tenant (defaults are the shared testnet deployment).
# Mainnet: fast-auth.near, v1.signer, login.auth.near.org, auth0.jwt.fast-auth.near.
FASTAUTH_CONTRACT_ID=fast-auth.testnet
FASTAUTH_MPC_CONTRACT_ID=v1.signer-prod.testnet
FASTAUTH_AUTH0_DOMAIN=login.testnet.fast-auth.com
FASTAUTH_AUTH0_AUDIENCE=https://api.testnet.fast-auth.com
# Sponsor wallet: the ONLY account the API signs transactions with. Unset =>
# POST /fastauth/* returns 503 sponsor_unconfigured. The key file is a NEAR
# key JSON {account_id, public_key, private_key}; relative paths resolve from
# backend/ (e.g. ../config/keys/sponsor.pratala.testnet.json, like GCS_KEY_FILE).
SPONSOR_ACCOUNT_ID=sponsor.pratala.testnet
SPONSOR_PRIVATE_KEY_FILE=../config/keys/sponsor.pratala.testnet.json
SPONSOR_PRIVATE_KEY=
# Gas + storage seed each fresh SSO account receives once, in NEAR.
SPONSOR_SEED_NEAR=1  # NEAR; must cover the 0.6 NEAR register_lot deposit for SSO farmers
