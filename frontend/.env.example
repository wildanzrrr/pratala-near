# Pratala web — copy to .env.local. Values below are the testnet defaults
# from docs/INTERFACES.md §1; deploy/testnet.json is authoritative after deploy.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://test.rpc.fastnear.com
NEXT_PUBLIC_LOTS_CONTRACT_ID=lots.pratala.testnet
NEXT_PUBLIC_PUSDC_CONTRACT_ID=pusdc.pratala.testnet
NEXT_PUBLIC_API_URL=http://localhost:4100/api
NEXT_PUBLIC_EXPLORER_BASE=https://testnet.nearblocks.io
NEXT_PUBLIC_AUTH_RECIPIENT=lots.pratala.testnet
# NEAR Auth email SSO — set these on mainnet; on mainnet the app hard-fails if any
# network value still says "testnet" (lib/env.ts). The client id comes from
# https://docs.auth.near.org. Empty (or a "none" placeholder) ⇒ the email-SSO
# button shows "Temporarily unavailable" and wallets carry sign-in. For the
# testnet walkthrough use the shared id np8paqIpMWmNbzT4xAvOOapZBjsOpptl.
NEXT_PUBLIC_FASTAUTH_CLIENT_ID=
NEXT_PUBLIC_FASTAUTH_CONTRACT_ID=fast-auth.testnet
NEXT_PUBLIC_FASTAUTH_MPC_CONTRACT_ID=v1.signer-prod.testnet
NEXT_PUBLIC_FASTAUTH_AUTH0_DOMAIN=login.testnet.fast-auth.com
NEXT_PUBLIC_FASTAUTH_API_AUDIENCE=https://api.testnet.fast-auth.com
NEXT_PUBLIC_SSO_ACCOUNT_ROOT=sponsor.pratala.testnet
# Fixed demo conversion shown as "≈ Rp" next to USDC amounts (labelled as a demo rate in the UI)
NEXT_PUBLIC_DEMO_IDR_RATE=18000
# Public origin used for canonical URLs, sitemap and OG images
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 1 = render three labelled sample lots from lib/fixtures.ts instead of chain data (design review only)
NEXT_PUBLIC_DEMO_FIXTURES=0
