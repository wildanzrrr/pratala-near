{
  "name": "pratala-near",
  "version": "0.1.0",
  "private": true,
  "description": "Pratala — verified harvest lots as NEAR NFTs with stablecoin escrow. NEAR Hackathon 2026.",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "pnpm -C frontend dev",
    "dev:api": "pnpm -C backend start:dev",
    "build:web": "pnpm -C frontend build",
    "build:api": "pnpm -C backend build",
    "contracts:build": "make -C smart-contract build",
    "contracts:test": "make -C smart-contract test",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down"
  }
}
